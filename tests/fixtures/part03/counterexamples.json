      "id": "P3-AUTHORITY",
      "invariant": "No inherited execution permission",
      "mutations": [
        {
          "chapter": 22,
          "path": [
            "authorityBoundary",
            "parentExecutionAuthorized"
          ],
          "value": true
        }
      ]
    },
    {
      "id": "P3-AUTH-BOOL",
      "invariant": "False must not equal zero",
      "mutations": [
        {
          "chapter": 22,
          "path": [
            "executionAuthorized"
          ],
          "value": 0
        }
      ]
    },
    {
      "id": "P3-DRAFT",
      "invariant": "Historical Draft unchanged",
      "mutations": [
        {
          "chapter": 21,
          "path": [
