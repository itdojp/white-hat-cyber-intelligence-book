{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://itdojp.github.io/white-hat-cyber-intelligence-book/schemas/site-pages.schema.json",
  "title": "Book Site Page Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "canonicalDirectories",
    "pages",
    "directoryRoutes"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "directoryRoutes": {
            "required": [
              "cases"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "canonicalDirectories": {
            "contains": {
              "const": "cases"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "directoryRoutes": {
            "required": [
              "schemas"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "canonicalDirectories": {
            "contains": {
              "const": "schemas"
            }
          }
        }
      }
    }
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.1.0"
    },
    "canonicalDirectories": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "cases",
          "schemas"
        ]
      }
    },
