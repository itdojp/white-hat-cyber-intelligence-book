{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://itdojp.github.io/white-hat-cyber-intelligence-book/schemas/site-pages.schema.json",
  "title": "Book Site Page Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "canonicalDirectories",
    "pages",
    "directoryRoutes"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "directoryRoutes": {
            "required": [
              "cases"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "canonicalDirectories": {
            "contains": {
              "const": "cases"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "directoryRoutes": {
            "required": [
              "schemas"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "canonicalDirectories": {
            "contains": {
              "const": "schemas"
            }
          }
        }
      }
    }
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.1.0"
    },
    "canonicalDirectories": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "cases",
          "schemas"
        ]
      }
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "destination",
          "section",
          "order",
          "title"
        ],
        "properties": {
          "source": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.md$"
          },
          "destination": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.md$"
          },
          "section": {
            "enum": [
              "introduction",
              "chapters",
              "additional",
              "resources",
              "appendices",
              "afterword"
            ]
          },
          "order": {
            "type": "integer",
            "minimum": 0
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?=.*[^\\s\u00ad\u0600-\u0605\u061c\u06dd\u070f\u0890-\u0891\u08e2\u180e\u200b-\u200f\u202a-\u202e\u2060-\u2064\u2066-\u206f\ufeff\ufff9-\ufffb\ud804\udcbd\ud804\udccd\ud80d\udc30-\ud80d\udc3f\ud82f\udca0-\ud82f\udca3\ud834\udd73-\ud834\udd7a\udb40\udc01\udb40\udc20-\udb40\udc7f])[^<>\\r\\n\\u2028\\u2029]+$"
          }
        }
      }
    },
    "directoryRoutes": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "cases",
          "schemas"
        ]
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.md$"
      }
    },
    "staticFiles": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "destination"
        ],
        "properties": {
          "source": {
            "type": "string",
            "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)[._])[A-Za-z0-9][A-Za-z0-9._/-]*\\.json$"
          },
          "destination": {
            "type": "string",
            "pattern": "^downloads/(?![._])(?!.*//)(?!.*\/[._])[A-Za-z0-9][A-Za-z0-9._/-]*\\.json$"
          }
        }
      }
    }
  }
}
