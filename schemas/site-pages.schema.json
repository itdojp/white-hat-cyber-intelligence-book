      "type": "object",
      "propertyNames": {
        "enum": [
          "cases",
          "schemas"
        ]
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.md$"
      }
    },
    "staticFiles": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "destination"
        ],
        "properties": {
          "source": {
            "type": "string",
            "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)[._])[A-Za-z0-9][A-Za-z0-9._/-]*\\.json$"
          },
          "destination": {
            "type": "string",
            "pattern": "^downloads/(?![._])(?!.*//)(?!.*\/[._])[A-Za-z0-9][A-Za-z0-9._/-]*\\.json$"
          }
        }
      }
    }
  }
}
